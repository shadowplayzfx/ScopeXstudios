{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated SCOPE-X user profile and studio preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "preferredVoice": { "type": "string", "maxLength": 120 },
        "defaultProvider": { "type": "string", "enum": ["auto", "gemini", "groq", "nvidia"] },
        "defaultModel": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "defaultProvider", "defaultModel", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A persistent SCOPE-X studio project.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["app", "research", "writer", "document", "image", "code"] },
        "fileCount": { "type": "number" },
        "activeVersion": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "description", "type", "fileCount", "activeVersion", "createdAt", "updatedAt"]
    },
    "ProjectFile": {
      "title": "ProjectFile",
      "description": "A generated or edited source file inside a SCOPE-X project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 256 },
        "language": { "type": "string", "minLength": 1, "maxLength": 40 },
        "content": { "type": "string", "maxLength": 300000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "ownerId", "path", "language", "content", "updatedAt"]
    },
    "ProjectVersion": {
      "title": "ProjectVersion",
      "description": "A point-in-time snapshot for project version history and undo.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "versionNumber": { "type": "number" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "snapshotJson": { "type": "string", "maxLength": 600000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "ownerId", "versionNumber", "summary", "snapshotJson", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "An AI assistant conversation thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "projectId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "projectId", "createdAt", "updatedAt"]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "A single message in a SCOPE-X AI conversation.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string", "maxLength": 100000 },
        "provider": { "type": "string", "maxLength": 60 },
        "model": { "type": "string", "maxLength": 120 },
        "toolActions": { "type": "string", "maxLength": 50000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "ownerId", "role", "content", "provider", "model", "toolActions", "createdAt"]
    },
    "PlaylistTrack": {
      "title": "PlaylistTrack",
      "description": "A saved music track in the user's SCOPE-X media library.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "artist": { "type": "string", "minLength": 1, "maxLength": 160 },
        "album": { "type": "string", "maxLength": 160 },
        "artworkUrl": { "type": "string", "maxLength": 600 },
        "previewUrl": { "type": "string", "maxLength": 600 },
        "externalUrl": { "type": "string", "maxLength": 600 },
        "durationSec": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "artist", "album", "artworkUrl", "previewUrl", "externalUrl", "durationSec", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles and studio model/voice preferences."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Studio projects owned by authenticated users."
    },
    "/projects/{projectId}/files/{fileId}": {
      "schema": { "$ref": "#/entities/ProjectFile" },
      "description": "Files belonging to a specific project."
    },
    "/projects/{projectId}/versions/{versionId}": {
      "schema": { "$ref": "#/entities/ProjectVersion" },
      "description": "Version snapshots belonging to a specific project."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Assistant conversation threads owned by authenticated users."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConversationMessage" },
      "description": "Messages belonging to a specific conversation."
    },
    "/playlists/{trackId}": {
      "schema": { "$ref": "#/entities/PlaylistTrack" },
      "description": "Saved playlist tracks owned by authenticated users."
    }
  }
}
